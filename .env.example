# === SOURCE ===
# simkl | plex | tautulli
PRIMARY_SOURCE=simkl

# === SIMKL ===
SIMKL_CLIENT_ID=your_client_id
SIMKL_CLIENT_SECRET=your_client_secret
# Where the OAuth access token is stored (relative paths are project-relative)
SIMKL_TOKEN_FILE=data/simkl_token.json
# Simkl timestamps are UTC. Most are midnight markers from a bulk import, but
# films marked as watched live carry a real time. Set to true to convert them
# to LOCAL_TIMEZONE before truncating to a calendar date.
SIMKL_CONVERT_TIMEZONE=false

# === PLEX (optional, secondary source) ===
PLEX_URL=http://localhost:32400
PLEX_TOKEN=

# === TAUTULLI (optional, secondary source) ===
TAUTULLI_URL=http://localhost:8181
TAUTULLI_API_KEY=
TAUTULLI_USER_ID=1

# === TMDB (optional enrichment; empty means disabled) ===
# Without a key the tool relies on the TMDB and IMDb ids the source provides.
TMDB_API_KEY=

# === BEHAVIOUR ===
LOCAL_TIMEZONE=Europe/Paris
EXPORT_WATCHLIST=true
SKIP_SERIES=true
# Split threshold, kept under the hard 1 MB limit of the Letterboxd importer
MAX_CSV_BYTES=950000

# === PATHS ===
OUTPUT_DIR=output
DATA_DIR=data
LOG_DIR=logs
DB_PATH=data/movies.db

# === LOGGING ===
LOG_LEVEL=INFO
CONSOLE_LOG_LEVEL=INFO

# === WEB DASHBOARD ===
WEB_PORT=19876
OAUTH_PORT=19877
# 0 disables the dashboard background sync (the scheduled task handles it)
SYNC_INTERVAL=0
